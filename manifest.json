{
  "schemaVersion": 1,
  "id": "kaktyc.liquid-widgets",
  "name": "Liquid Widgets",
  "version": "0.2.0",
  "author": "kaktyc",
  "license": "MIT",
  "description": "Desktop widgets with the hyprglass liquid-glass effect: clock, load monitor, graphics card, memory, power profile and battery. Toggle each widget from the bar popup, drag them anywhere with the right mouse button and resize them by dragging a corner.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Liquid Widgets",
    "description": "Liquid-glass desktop widgets (clock, load, memory, power, battery) with per-widget toggles and corner resize.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "widgets": [
        "clock",
        "system",
        "gpu",
        "power",
        "battery"
      ],
      "positions": {},
      "sizes": {},
      "position": "top-right",
      "marginX": 28,
      "marginY": 20,
      "cardWidth": 240,
      "spacing": 12,
      "opacity": 0.35,
      "radius": 22,
      "monitor": "",
      "intervalMs": 2000,
      "timeFormat": "24h",
      "clockStyle": "default",
      "showDate": true,
      "showLabels": true,
      "showCpuCores": true
    },
    "schema": [
      {
        "key": "position",
        "type": "string",
        "label": "Screen position",
        "description": "top-left, top-center, top-right, middle-left, middle-right, bottom-left, bottom-center or bottom-right.",
        "defaultValue": "top-right"
      },
      {
        "key": "opacity",
        "type": "number",
        "label": "Card background opacity",
        "description": "0.05 to 1. Lower values let more of the hyprglass effect through.",
        "defaultValue": 0.35
      },
      {
        "key": "cardWidth",
        "type": "number",
        "label": "Default widget width in pixels",
        "defaultValue": 240
      },
      {
        "key": "spacing",
        "type": "number",
        "label": "Gap between widgets in pixels",
        "defaultValue": 12
      },
      {
        "key": "marginX",
        "type": "number",
        "label": "Horizontal screen margin in pixels",
        "defaultValue": 28
      },
      {
        "key": "marginY",
        "type": "number",
        "label": "Vertical screen margin in pixels",
        "defaultValue": 20
      },
      {
        "key": "radius",
        "type": "number",
        "label": "Card corner radius in pixels",
        "defaultValue": 22
      },
      {
        "key": "intervalMs",
        "type": "number",
        "label": "Sampling interval in milliseconds",
        "description": "500 to 60000. Sampling stops entirely while the widgets are hidden.",
        "defaultValue": 2000
      },
      {
        "key": "timeFormat",
        "type": "string",
        "label": "Clock",
        "description": "24h or 12h.",
        "defaultValue": "24h"
      },
      {
        "key": "clockStyle",
        "type": "string",
        "label": "Clock face",
        "description": "default (large time with date) or digits (bare time as glassy numerals).",
        "defaultValue": "default"
      },
      {
        "key": "monitor",
        "type": "string",
        "label": "Limit the widgets to one monitor",
        "description": "A connector name such as eDP-1. Leave empty for every monitor.",
        "defaultValue": ""
      },
      {
        "key": "showDate",
        "type": "boolean",
        "label": "Show the date under the clock",
        "defaultValue": true
      },
      {
        "key": "showLabels",
        "type": "boolean",
        "label": "Show widget titles",
        "defaultValue": true
      },
      {
        "key": "showCpuCores",
        "type": "boolean",
        "label": "Show a bar per CPU thread",
        "defaultValue": true
      }
    ]
  }
}
